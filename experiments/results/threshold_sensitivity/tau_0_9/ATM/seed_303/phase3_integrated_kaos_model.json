    {
      "id": "PRI-L2-003-02",
      "name": "Privacy Requirement 2",
      "description": "The system shall ensure privacy (data minimisation, consent management, data subject rights per GDPR and ISO 27701): The application should automatically withdraw funds from a related saving-account if the requested withdrawal amount on the checking-account is more than its current balance",
